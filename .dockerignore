job_agent/.ruff_cache
job_agent/.pytest_cache
job_agent/.mypy_cache
job_agent/personal_job_agent.egg-info
job_agent/systemd
job_agent/uv.lock
job_agent/requirements.txt
job_agent/.env.example
job_agent/.gitignore

# Local development artifacts.
.git
.venv
.pytest_cache
.ruff_cache
__pycache__
*.py[cod]
*.pyc
*.log
.DS_Store

# Test tooling is not needed in the production image.
tests

# Dev docs / scratch scripts are not part of the runtime image.
docs
scripts
AGENTS.md

# Generated local AI/design tooling state (not product, not needed in image).
.ua
design-md
.opencode

# Keep git/Docker meta files out of the image where harmless; README.md and
# uv.lock / pyproject.toml stay in (hatchling needs README.md to build).
.gitignore
.dockerignore