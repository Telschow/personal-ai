# Build context is the repository root (docker/Dockerfile is referenced from
# docker/docker-compose.yml with `context: ..`). NEVER copy private personal
# data or local development artifacts into the image.

# Private raw data (also git-ignored) — never shipped in an image.
Email_Outlook
Financial_data
Workouts
previous_project_and_raw_data
raw_data.zip
raw_data_extracted

# Local runtime data / SQLite databases.
data
knowledge.db
*.db
*.sqlite
*.sqlite3
*.db-wal
*.db-shm
*.sqlite-wal
*.sqlite-shm

# Job-Agent private/derived data and local dev artifacts (the package itself,
# sources_catalog.yaml, profile/ and templates/ stay in the image).
job_agent/output
job_agent/config.yaml
job_agent/company_radar.yaml
job_agent/profile/profile.yaml
career
career_output
*.backup
*.bak
