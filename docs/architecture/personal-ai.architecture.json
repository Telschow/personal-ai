  "cards": [
    {
      "dot": "cyan",
      "title": "Ingestion & sources",
      "items": [
        "Adapters: Keep · NotebookLM · Gemini · ChatGPT · email · financial · files",
        "Extract → chunk → classify → embed → store (DocumentStore, FTS5, EmbeddingStore)",
        "Conversations → ConversationStore · Chrome/YouTube → EventStore"
      ]
    },
    {
      "dot": "emerald",
      "title": "Retrieval & memory",
      "items": [
        "Keyword default · semantic/hybrid opt-in (fail loudly, never silent degrade)",
        "MemoryService: SQLite memories + audit trail, chat auto-recall (≤ 3)",
        "Person blocks and workout queries via policy-gated tools"
      ]
    },
    {
      "dot": "amber",
      "title": "Execution control plane",
      "items": [
        "Planner → Orchestrator → Researcher → DeterministicVerifier",
        "Durable task-scoped approvals · Kanban board API",
        "Explicit tool allow-list only — no eval/exec/shell/dynamic imports"
      ]
    },
    {
      "dot": "violet",
      "title": "Job agent pipeline",
      "items": [
        "Query plan → rate-limited discovery → normalize → score → persist",
        "Reads sibling job-agent.db on the same data volume · never auto-submits",
        "Career artifacts: CV / cover-letter upload, preview, DRAFT → APPROVED",
        "generate_materials via the local Ollama model"
      ]
    }
  ]
