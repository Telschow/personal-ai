# Personal AI Local Configuration
# Copy to .env and fill values. NEVER commit .env

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
PERSONAL_AI_CHAT_MODEL=qwen3.5:9b

# Data directories - MUST be local, never committed
PERSONAL_AI_DATA_DIR=data/private
PERSONAL_AI_WORKSPACE=data/local/workspace

# API
PERSONAL_AI_API_HOST=127.0.0.1
PERSONAL_AI_API_PORT=8000
PERSONAL_AI_API_TOKEN=

# Optional features
PERSONAL_AI_EMBEDDING_MODEL=
PERSONAL_AI_VISION_MODEL=
