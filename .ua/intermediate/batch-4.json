{
  "nodes": [
    {
      "id": "document:docs/AGENT_ORCHESTRATION.md",
      "type": "document",
      "name": "AGENT_ORCHESTRATION.md",
      "filePath": "docs/AGENT_ORCHESTRATION.md",
      "summary": "Design overview of the local-first, policy-enforced agent orchestration runtime (legacy Phase 39A/39B): plan/task/executor/verifier workflow, trust boundaries and security invariants, agent memory retrieval, read-only fetch tools, automatic chat recall, and the control-plane durable approval integration.",
      "tags": ["documentation", "orchestration", "agent", "security", "architecture"],
      "complexity": "moderate",
      "languageNotes": "11 sections covering four distinct SDK concepts (Agent, Skill, AgentTool, AccessPolicy) and the deterministic researcher -> verifier workflow."
    },
    {
      "id": "document:docs/CONTROL_PLANE.md",
      "type": "document",
      "name": "CONTROL_PLANE.md",
      "filePath": "docs/CONTROL_PLANE.md",
      "summary": "Specifies the execution control plane (legacy Phase 39): durable SQLite-backed executions, typed plan/task state machines, cursor-based event streams, scope-exact durable approvals, resumability, and the Kanban board read projection plus CLI and HTTP API contracts.",
      "tags": ["documentation", "control-plane", "state-machine", "approval", "architecture"],
      "complexity": "moderate",
      "languageNotes": "13 sections documenting lifecycle state machines, event model, and the /api/executions/* HTTP gateway contract served by src/personal_ai/server.py."
    },
    {
      "id": "document:docs/DOCKER.md",
      "type": "document",
      "name": "DOCKER.md",
      "filePath": "docs/DOCKER.md",
      "summary": "Deployment guide for the Dockerized Personal AI gateway (legacy Phase 45): Docker Compose service joining the Open WebUI and Ollama bridge networks, build/run commands, verification steps, and persistence and security notes.",
      "tags": ["documentation", "docker", "deployment", "infrastructure", "networking"],
      "complexity": "moderate",
      "languageNotes": "6 sections explaining the two-external-network topology that keeps all traffic on container bridge networks with no host port or firewall holes."
    },
    {
      "id": "document:docs/MEMORY.md",
      "type": "document",
      "name": "MEMORY.md",
      "filePath": "docs/MEMORY.md",
      "summary": "Full specification of the memory layer (legacy Phase 40 plus subsequent slices): typed domain model, SQLite storage, deterministic lexical retrieval, service boundary, untrusted-context handling, automatic chat recall, LLM-assisted candidate proposals, durable full-corpus curation, unified adapters, and per-phase implementation notes through Phase 30.",
      "tags": ["documentation", "memory", "retrieval", "security", "architecture"],
      "complexity": "complex",
      "languageNotes": "48 sections; the deepest documented subsystem, covering memory as data-never-policy with strict provenance, idempotency, and privacy invariants."
    },
    {
      "id": "document:docs/OPEN_WEBUI.md",
      "type": "document",
      "name": "OPEN_WEBUI.md",
      "filePath": "docs/OPEN_WEBUI.md",
      "summary": "Guide for using Personal AI as an OpenAI-compatible backend in front of Open WebUI: starting the API server, environment variables, Open WebUI configuration for local and Docker installs, and the OpenAI-compatible /v1 API reference with smoke-test instructions.",
      "tags": ["documentation", "open-webui", "api", "integration", "openai-compatible"],
      "complexity": "moderate",
      "languageNotes": "Documents the GET /v1/models and POST /v1/chat/completions contracts served by src/personal_ai/server.py."
    },
    {
      "id": "document:docs/RETRIEVAL.md",
      "type": "document",
      "name": "RETRIEVAL.md",
      "filePath": "docs/RETRIEVAL.md",
      "summary": "Canonical retrieval contract: model-facing result envelope, status separation, input bounds, determinism, the retrieval boundary implemented by SQLiteChunkIndex/SemanticChunkIndex/HybridChunkIndex, hybrid retrieval design and Phase 36 implementation notes, deterministic evaluation, and operator-configurable retrieval mode.",
      "tags": ["documentation", "retrieval", "hybrid-search", "contract", "evaluation"],
      "complexity": "complex",
      "languageNotes": "32 sections; refers to ChunkIndex implementations in storage/chunks.py, semantic_index.py, and hybrid_index.py and fusion/score semantics."
    },
    {
      "id": "document:docs/ROADMAP.md",
      "type": "document",
      "name": "ROADMAP.md",
      "filePath": "docs/ROADMAP.md",
      "summary": "Project roadmap and implementation-status tracker covering the canonical and legacy phase-numbering schemes, per-phase implementation notes for Phases 1-52, deferred/future work, historical roadmap, and working principles.",
      "tags": ["documentation", "roadmap", "planning", "history", "phase-tracking"],
      "complexity": "complex",
      "languageNotes": "45 sections reconciling canonical vs legacy numbering (e.g. memory/retriever.py 'Phase 40' markers are historical, not canonical)."
    },
    {
      "id": "document:docs/USAGE.md",
      "type": "document",
      "name": "USAGE.md",
      "filePath": "docs/USAGE.md",
      "summary": "User guide covering supported ingestion paths (files, email, financial exports, ChatGPT/Gemini conversations, events), deterministic and LLM-assisted memory extraction, full-corpus memory curation, unified corpus search, vision extraction for image-heavy PDFs, smoke-test instructions, and known limitations.",
      "tags": ["documentation", "user-guide", "ingestion", "cli", "limitations"],
      "complexity": "complex",
      "languageNotes": "16 sections of command-line workflows driven by src/personal_ai/cli.py."
    },
    {
      "id": "document:docs/WORKOUTS.md",
      "type": "document",
      "name": "WORKOUTS.md",
      "filePath": "docs/WORKOUTS.md",
      "summary": "Specification of the workout dataset subsystem (legacy Phase 43): deterministic Boostcamp CSV parsing pipeline, normalized domain model, idempotent SQLite storage, read-only query surface, CLI, agent tool and HTTP gateway exposure, and testing strategy.",
      "tags": ["documentation", "workouts", "data-model", "parsing", "storage"],
      "complexity": "moderate",
      "languageNotes": "12 sections documenting the parse/store/query pipeline that is pure deterministic Python with no network or LLM dependency."
    }
